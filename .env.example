
# ==========================================
# Kry - Environment Configuration
# ==========================================
# Copy this file to .env and add your keys.
# Never commit your actual .env file.

# Riot Games API
# Get a development key at:
# https://developer.riotgames.com/
# Development keys expire every 24 hours.
RIOT_API_KEY=RGAPI_REPLACE_ME

# Google Gemini API
# Get a key at:
# https://aistudio.google.com/api-keys
# Optional: Without this, Kry uses rule-based roasts.
GEMINI_API_KEY=

# Application Mode
# 1 = Public demo with sample statistics
# 0 = Live mode (requires appropriate API access)
DEMO_MODE=1

# Riot Production Authorization
# Keep disabled until Riot approves production access.
RIOT_PRODUCTION_APPROVED=0
